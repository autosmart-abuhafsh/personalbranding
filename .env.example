# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://portofolioabuhafsh.vercel.app)
APP_URL="https://portofolioabuhafsh.vercel.app"

# VITE_APPS_SCRIPT_WEBHOOK_URL: URL Web App Google Apps Script (berakhiran /exec)
# Digunakan untuk menyimpan data formulir pelanggan otomatis ke Google Sheets.
# Dapat diatur di Environment Variables Vercel atau langsung di src/data/profile.ts
VITE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbwlSjHIRrchWHLk88nplEg0ba52c1r0MSkhpjbQNrck1C6UwEtae7EmYTGigGdZhSKY/exec"
